{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**/*.js",
      "**/*.json",
      "**/*.jsonc",
      "**/*.json5",
      "**/*.css",
      "**/*.html",
      "!**/packages.lock.json"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "enabled": true
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  }
}
