# Claude Code workaround: its sandbox bind-mounts /dev/null over host dot-files
# (.bashrc, .zshrc, .mcp.json, .claude/{agents,commands,hooks}, ...), scattering
# junk into the repo root. Ignore all dot-prefixed entries by default, then
# re-include only the ones this repository actually tracks.
.*
!.claude/
!.codex/
!.devcontainer/
!.editorconfig
!.gitattributes
!.git-blame-ignore-revs
!.github/
!.gitignore

# Agent scratch plans live under the tracked .claude/ directory; keep them out.
.claude/plans/

# General ignoring files
*~
*.swp
*.bak
*.tmp
*.log
*.cache
.DS_Store
Thumbs.db

# Outputs
/artifacts/

# IDE Cache files
/packages/

# IDE user-specific files
/*.suo
/.vs/
/.idea/
/_ReSharper.*/
*.csproj.lscache
*.user
*.psess
*.vsp
*.vspx
project.lock.json

# Backup & report files from converting an old project file to a newer
/_UpgradeReport_Files/
/Backup*/
/UpgradeLog*.XML

# Generated files
*.Generated.*
