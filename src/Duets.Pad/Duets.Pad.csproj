<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Duets.Pad</PackageId>
    <Authors>takeshik</Authors>
    <Description>DuetsPad browser debug pad for Duets: Monaco editor, canvas, and timeline served over HTTP.</Description>
    <Copyright>Copyright © Takeshi KIRIYA (aka takeshik) &lt;takeshik@tksk.io&gt;</Copyright>
    <PackageProjectUrl>https://github.com/takeshik/Duets</PackageProjectUrl>
    <RepositoryUrl>https://github.com/takeshik/Duets</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>TypeScript JavaScript REPL debug pad</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Duets\Duets.csproj" />
    <ProjectReference Include="..\HttpHarker\HttpHarker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="PolySharp"
      PrivateAssets="all"
      Condition="'$(TargetFramework)' == 'netstandard2.1'"
    />
    <PackageReference
      Include="System.Text.Json"
      Condition="'$(TargetFramework)' == 'netstandard2.1'"
    />
    <PackageReference
      Include="System.Threading.Channels"
      Condition="'$(TargetFramework)' == 'netstandard2.1'"
    />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\*.cs" Link="(shared)\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Duets.Pad.Tests$(_AssemblyNamePublicKeySuffix)" />
  </ItemGroup>
</Project>
